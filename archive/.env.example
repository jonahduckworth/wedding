# Names and non-secret defaults only. Do not put passwords in this file.
ARCHIVE_ORIGIN=https://wedding.jdbuilds.ca
ARCHIVE_PUBLIC_DIR=/absolute/path/to/frontend/dist
ARCHIVE_UPLOADS_DIR=/absolute/path/to/private-readonly-uploads
ARCHIVE_AUTH_FILE=/absolute/path/to/private/archive-auth.json
ARCHIVE_DATABASE_URL_FILE=/absolute/path/to/private/archive-database-url
# TLS with certificate validation is the default.
# ARCHIVE_DB_CA_FILE=/absolute/path/to/private/database-ca.pem
# Private-network plaintext is deliberately NOT enabled here.
PORT=8080
